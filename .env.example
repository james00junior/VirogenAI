# Application
VIROGENAI_ENV=development
VIROGENAI_LOG_LEVEL=INFO

# API
VIROGENAI_API_HOST=0.0.0.0
VIROGENAI_API_PORT=8000

# Database
VIROGENAI_DATABASE_URL=postgresql://virogenai:virogenai@localhost:5432/virogenai

# LLM provider: api | ollama
VIROGENAI_LLM_PROVIDER=api
VIROGENAI_OLLAMA_BASE_URL=http://localhost:11434
VIROGENAI_OLLAMA_MODEL=

# Secrets must be supplied through the runtime environment.
VIROGENAI_LLM_API_KEY=
